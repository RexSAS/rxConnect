{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rxConnect",
  "version": "1.0.0",
  "identifier": "com.andrea.rxconnect",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "rxConnect", "width": 1100, "height": 720, "useHttpsScheme": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
