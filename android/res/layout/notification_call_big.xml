<?xml version="1.0" encoding="utf-8"?>
<!-- The call notification expanded (CallService): room and timer on top, a row of big buttons below.
     Android starts custom content at the text column (right of the app icon), so the row is ~28dp right of the
     card's middle; marginEnd 56dp (2 × 28) centres it on the card. Measured on a Nothing phone, Android 17. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:singleLine="true" android:ellipsize="end" />
    <Chronometer android:id="@+id/timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:layout_marginBottom="4dp"
        android:layout_marginEnd="56dp"
        android:orientation="horizontal" android:gravity="center">
        <ImageView android:id="@+id/mic" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:padding="11dp" android:background="@drawable/btn_ring" android:src="@drawable/ic_mic" />
        <ImageView android:id="@+id/cam" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:layout_marginStart="10dp" android:padding="11dp" android:background="@drawable/btn_ring" android:src="@drawable/ic_cam" />
        <ImageView android:id="@+id/leave" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:layout_marginStart="10dp" android:padding="10dp" android:background="@drawable/btn_leave" android:src="@drawable/ic_call_end"
            android:contentDescription="Leave" />
    </LinearLayout>
</LinearLayout>
